{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "screenshot-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat_v2"],
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
